# Gemini free-tier key (https://aistudio.google.com/apikey). Without it, AI sources are skipped.
GEMINI_API_KEY=
# Public URL where /public is served (used for subscribe links on index.html)
TE_PUBLIC_BASE_URL=http://localhost:8080
# Optional overrides
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
# TE_AI_MAX_CALLS=300
# TE_AI_DESC_DAILY_LIMIT=15   # Gemini requests/day for descriptions of events with several sources
# TE_RADIUS_KM=50
# Google AdSense. CLIENT alone: site-verification meta tag + ads.txt. CLIENT + SLOT: also the banner.
# TE_ADSENSE_CLIENT=ca-pub-1234567890123456
# TE_ADSENSE_SLOT=1234567890
